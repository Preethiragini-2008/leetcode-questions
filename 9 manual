import java.sql.*;

public class StudentDB {

    static final String URL = "jdbc:mysql://localhost:3306/college";
    static final String USER = "root";
    static final String PASSWORD = "your_password"; // Change as needed

    public static void main(String[] args) {

        try {

            // 1. Load JDBC Driver
            Class.forName("com.mysql.cj.jdbc.Driver");

            // 2. Establish Connection
            Connection con = DriverManager.getConnection(URL, USER, PASSWORD);

            // 3. Insert Two Student Records
            String insertSQL =
                    "INSERT INTO student (rollno, name, department, marks) VALUES (?, ?, ?, ?)";

            PreparedStatement insertStmt = con.prepareStatement(insertSQL);

            // First Record
            insertStmt.setInt(1, 101);
            insertStmt.setString(2, "Rahul");
            insertStmt.setString(3, "CSE");
            insertStmt.setInt(4, 90);
            insertStmt.executeUpdate();

            // Second Record
            insertStmt.setInt(1, 102);
            insertStmt.setString(2, "Sneha");
            insertStmt.setString(3, "ISE");
            insertStmt.setInt(4, 91);
            insertStmt.executeUpdate();

            System.out.println("Records Inserted Successfully.");

            // 4. Update Student Marks
            String updateSQL =
                    "UPDATE student SET marks = ? WHERE rollno = ?";

            PreparedStatement updateStmt = con.prepareStatement(updateSQL);

            updateStmt.setInt(1, 95);
            updateStmt.setInt(2, 101);
            updateStmt.executeUpdate();

            System.out.println("\nRecord Updated Successfully.");

            // 5. Search for a Student
            String searchSQL =
                    "SELECT * FROM student WHERE rollno = ?";

            PreparedStatement searchStmt = con.prepareStatement(searchSQL);

            searchStmt.setInt(1, 101);

            ResultSet rs = searchStmt.executeQuery();

            System.out.println("\nStudent Details");

            if (rs.next()) {

                System.out.println("Roll No    : " + rs.getInt("rollno"));
                System.out.println("Name       : " + rs.getString("name"));
                System.out.println("Department : " + rs.getString("department"));
                System.out.println("Marks      : " + rs.getInt("marks"));

            } else {

                System.out.println("Student not found.");
            }

            // 6. Display All Student Records
            String displaySQL = "SELECT * FROM student";

            Statement stmt = con.createStatement();
            ResultSet allRs = stmt.executeQuery(displaySQL);

            System.out.println("\nStudent Records");
            System.out.println("--------------------------------------------");
            System.out.printf("%-6s %-10s %-14s %-6s%n",
                    "Roll", "Name", "Department", "Marks");
            System.out.println("--------------------------------------------");

            while (allRs.next()) {

                System.out.printf("%-6d %-10s %-14s %-6d%n",
                        allRs.getInt("rollno"),
                        allRs.getString("name"),
                        allRs.getString("department"),
                        allRs.getInt("marks"));
            }

            // 7. Close Resources
            rs.close();
            allRs.close();
            insertStmt.close();
            updateStmt.close();
            searchStmt.close();
            stmt.close();
            con.close();

        } catch (ClassNotFoundException e) {

            System.out.println("JDBC Driver not found: " + e.getMessage());

        } catch (SQLException e) {

            System.out.println("Database error: " + e.getMessage());
        }
    }
}
